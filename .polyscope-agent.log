);\n  1076→  render();\n  1077→}\n  1078→async function addSite() {\n  1079→  const site = document.getElementById('newsite').value.trim().replace(/^https?:\\\\/\\\\//, '').replace(/\\\\/+$/, '');\n  1080→  if (!site) return;\n  1081→  const cfg = await api('/config');\n  1082→  cfg.allowed_sites.push(site);\n  1083→  await api('/config', 'POST', { allowed_sites: cfg.allowed_sites });\n  1084→  render();\n  1085→}\n  1086→async function removeSite(site) {\n  1087→  const cfg = await api('/config');\n  1088→  cfg.allowed_sites = cfg.allowed_sites.filter(s => s !== site);\n  1089→  await api('/config', 'POST', { allowed_sites: cfg.allowed_sites });\n  1090→  render();\n  1091→}\n  1092→async function resetTime() {\n  1093→  if (confirm('Reset today\\\\'s time usage to zero?')) { await api('/reset-time', 'POST'); render(); }\n  1094→}\n  1095→async function applyPolicies() {\n  1096→  const r = await api('/apply-policies', 'POST');\n  1097→  alert(r.message || 'Done');\n  1098→}\n  1099→async function stopKiosk() {\n  1100→  if (confirm('Stop the kiosk? Firefox will close.')) { await api('/stop-kiosk', 'POST'); render(); }\n  1101→}\n  1102→\n  1103→render();\n  1104→setInterval(render, 30000);\n  1105→</script>\n  1106→</body>\n  1107→</html>\"\"\"\n  1108→\n  1109→\n  1110→class DashboardHandler(BaseHTTPRequestHandler):\n  1111→    \"\"\"HTTP handler for the parent dashboard.\"\"\"\n  1112→\n  1113→    server_version: str = \"KidSafe/1.0\"\n  1114→    config: Optional[Dict[str, Any]] = None\n  1115→    kiosk: Optional[KioskManager] = None\n  1116→    auth_tokens: Set[str] = set()\n  1117→"}]},"parent_tool_use_id":null,"session_id":"5f02eaca-ad87-4794-81b5-499b307ad8d6","uuid":"585ce364-6c2a-4c29-b1fa-80975dd85bde","tool_use_result":{"type":"text","file":{"filePath":"/Users/tony/docker-dev/projects/kidsafe/kidsafe.py","content":"      <div class=\"form-row\" style=\"margin-top:12px\">\n        <input type=\"text\" id=\"newsite\" placeholder=\"example.com\">\n        <button onclick=\"addSite()\">Add</button>\n      </div>\n    </div>\n\n    <h2>Usage History (7 days)</h2>\n    <div class=\"card\">\n      <table><tr><th>Date</th><th>Minutes</th></tr>\n        ${(history || []).map(h => `<tr><td>${h.date}</td><td>${h.minutes}</td></tr>`).join('')}\n      </table>\n    </div>\n\n    <h2>Recent Activity</h2>\n    <div class=\"card\">\n      <table><tr><th>Time</th><th>Event</th><th>Detail</th></tr>\n        ${(events || []).slice(0, 20).map(e => `<tr><td>${new Date(e.time).toLocaleString()}</td><td><span class=\"event-type ${e.type}\">${e.type}</span></td><td>${e.detail || ''}</td></tr>`).join('')}\n      </table>\n    </div>\n\n    <h2>Controls</h2>\n    <div class=\"card\">\n      <button onclick=\"resetTime()\">Reset Today's Time</button>\n      <button onclick=\"applyPolicies()\">Apply Firefox Policies</button>\n      <button class=\"danger\" onclick=\"stopKiosk()\">Stop Kiosk</button>\n    </div>`;\n}\n\nasync function saveLimit() {\n  await api('/config', 'POST', { daily_limit_minutes: parseInt(document.getElementById('limit').value) });\n  render();\n}\nasync function saveSchedule() {\n  await api('/config', 'POST', { schedule: { enabled: true, allowed_start: document.getElementById('sched_start').value, allowed_end: document.getElementById('sched_end').value }});\n  render();\n}\nasync function saveHomepage() {\n  await api('/config', 'POST', { homepage: document.getElementById('homepage').value });\n  render();\n}\nasync function addSite() {\n  const site = document.getElementById('newsite').value.trim().replace(/^https?:\\\\/\\\\//, '').replace(/\\\\/+$/, '');\n  if (!site) return;\n  const cfg = await api('/config');\n  cfg.allowed_sites.push(site);\n  await api('/config', 'POST', { allowed_sites: cfg.allowed_sites });\n  render();\n}\nasync function removeSite(site) {\n  const cfg = await api('/config');\n  cfg.allowed_sites = cfg.allowed_sites.filter(s => s !== site);\n  await api('/config', 'POST', { allowed_sites: cfg.allowed_sites });\n  render();\n}\nasync function resetTime() {\n  if (confirm('Reset today\\\\'s time usage to zero?')) { await api('/reset-time', 'POST'); render(); }\n}\nasync function applyPolicies() {\n  const r = await api('/apply-policies', 'POST');\n  alert(r.message || 'Done');\n}\nasync function stopKiosk() {\n  if (confirm('Stop the kiosk? Firefox will close.')) { await api('/stop-kiosk', 'POST'); render(); }\n}\n\nrender();\nsetInterval(render, 30000);\n</script>\n</body>\n</html>\"\"\"\n\n\nclass DashboardHandler(BaseHTTPRequestHandler):\n    \"\"\"HTTP handler for the parent dashboard.\"\"\"\n\n    server_version: str = \"KidSafe/1.0\"\n    config: Optional[Dict[str, Any]] = None\n    kiosk: Optional[KioskManager] = None\n    auth_tokens: Set[str] = set()\n","numLines":80,"startLine":1038,"totalLines":1401}}}
