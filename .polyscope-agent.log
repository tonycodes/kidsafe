{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QynGk2r6zdGqLDZjjk4mci","type":"tool_result","content":"     1→#!/bin/bash\n     2→# KidSafe installer for macOS\n     3→# Usage: curl -fsSL https://raw.githubusercontent.com/tonycodes/kidsafe/main/install.sh | sudo bash -s -- [child_username]\n     4→#    or: sudo bash install.sh [child_username]\n     5→\n     6→set -e\n     7→\n     8→KIDSAFE_VERSION=\"1.0.0\"\n     9→KIDSAFE_DIR=\"/usr/local/kidsafe\"\n    10→REPO_URL=\"https://raw.githubusercontent.com/tonycodes/kidsafe/main\"\n    11→CHILD_USER=\"${1:-emilio}\"\n    12→\n    13→# Colors\n    14→RED='\\033[0;31m'\n    15→GREEN='\\033[0;32m'\n    16→YELLOW='\\033[1;33m'\n    17→BLUE='\\033[0;34m'\n    18→NC='\\033[0m'\n    19→\n    20→info()  { echo -e \"${BLUE}[INFO]${NC} $1\"; }\n    21→ok()    { echo -e \"${GREEN}[OK]${NC} $1\"; }\n    22→warn()  { echo -e \"${YELLOW}[WARN]${NC} $1\"; }\n    23→err()   { echo -e \"${RED}[ERROR]${NC} $1\"; }\n    24→\n    25→echo\n    26→echo -e \"${GREEN}╔══════════════════════════════════════╗${NC}\"\n    27→echo -e \"${GREEN}║     KidSafe Installer v${KIDSAFE_VERSION}         ║${NC}\"\n    28→echo -e \"${GREEN}║  Parental Controls for macOS         ║${NC}\"\n    29→echo -e \"${GREEN}╚══════════════════════════════════════╝${NC}\"\n    30→echo\n    31→\n    32→# --- Pre-flight checks ---\n    33→\n    34→# Must be root\n    35→if [ \"$EUID\" -ne 0 ]; then\n    36→    err \"Please run with sudo:\"\n    37→    echo \"  curl -fsSL ${REPO_URL}/install.sh | sudo bash -s -- ${CHILD_USER}\"\n    38→    exit 1\n    39→fi\n    40→\n    41→# macOS only\n    42→if [ \"$(uname)\" != \"Darwin\" ]; then\n    43→    err \"KidSafe only works on macOS.\"\n    44→    exit 1\n    45→fi\n    46→\n    47→# Check Python 3\n    48→if ! command -v python3 &>/dev/null; then\n    49→    err \"Python 3 is required. Install Xcode Command Line Tools:\"\n    50→    echo \"  xcode-select --install\"\n    51→    exit 1\n    52→fi\n    53→\n    54→# Check child user exists\n    55→if ! dscl . read /Users/$CHILD_USER &>/dev/null; then\n    56→    err \"User '$CHILD_USER' does not exist on this Mac.\"\n    57→    echo \"  Available users:\"\n    58→    dscl . list /Users | grep -v '^_' | grep -v '^root$' | grep -v '^nobody$' | grep -v '^daemon$' | sed 's/^/    /'\n    59→    exit 1\n    60→fi\n    61→\n    62→# Check Firefox is installed\n    63→if [ ! -d \"/Applications/Firefox.app\" ]; then\n    64→    err \"Firefox is not installed. Download it from https://www.mozilla.org/firefox/\"\n    65→    exit 1\n    66→fi\n    67→\n    68→info \"Installing for child user: ${YELLOW}${CHILD_USER}${NC}\"\n    69→echo\n    70→\n    71→# --- Stop old version if running ---\n    72→\n    73→if pgrep -f \"kidsafe.py start\" >/dev/null 2>&1; then\n    74→    info \"Stopping old KidSafe instance...\"\n    75→    pkill -f \"kidsafe.py start\" 2>/dev/null || true\n    76→    sleep 1\n    77→    ok \"Old instance stopped\"\n    78→fi\n    79→\n    80→# --- Download files ---\n    81→\n    82→info \"Downloading KidSafe...\"\n    83→mkdir -p \"$KIDSAFE_DIR\"\n    84→\n    85→# Detect if running from local clone or via curl\n    86→if [ -f \"$(dirname \"$0\")/kidsafe.py\" ] && [ \"$(dirname \"$0\")\" != \".\" -o -f \"./kidsafe.py\" ]; then\n    87→    # Local install — copy from current directory\n    88→    SCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n    89→    cp \"$SCRIPT_DIR/kidsafe.py\" \"$KIDSAFE_DIR/kidsafe.py\"\n    90→    cp \"$SCRIPT_DIR/uninstall.sh\" \"$KIDSAFE_DIR/uninstall.sh\"\n    91→    [ -f \"$SCRIPT_DIR/kidsafe.mobileconfig\" ] && cp \"$SCRIPT_DIR/kidsafe.mobileconfig\" \"$KIDSAFE_DIR/kidsafe.mobileconfig\"\n    92→    ok \"Copied from local files\"\n    93→else\n    94→    # Remote install — download from GitHub\n    95→    curl -fsSL \"${REPO_URL}/kidsafe.py\" -o \"$KIDSAFE_DIR/kidsafe.py\"\n    96→    curl -fsSL \"${REPO_URL}/uninstall.sh\" -o \"$KIDSAFE_DIR/uninstall.sh\"\n    97→    curl -fsSL \"${REPO_URL}/kidsafe.mobileconfig\" -o \"$KIDSAFE_DIR/kidsafe.mobileconfig\" 2>/dev/null || true\n    98→    ok \"Downloaded from GitHub\"\n    99→fi\n   100→\n   101→chmod +x \"$KIDSAFE_DIR/kidsafe.py\"\n   102→chmod +x \"$KIDSAFE_DIR/uninstall.sh\"\n   103→\n   104→# Create symlink\n   105→ln -sf \"$KIDSAFE_DIR/kidsafe.py\" /usr/local/bin/kidsafe\n   106→ok \"Installed to $KIDSAFE_DIR\"\n   107→\n   108→# --- Setup child user ---\n   109→\n   110→CHILD_HOME=$(dscl . read /Users/$CHILD_USER NFSHomeDirectory | awk '{print $2}')\n   111→sudo -u $CHILD_USER mkdir -p \"$CHILD_HOME/.kidsafe\"\n   112→ok \"Created config directory: $CHILD_HOME/.kidsafe\"\n   113→\n   114→# --- Create LaunchAgent for child (auto-start kiosk on login) ---\n   115→\n   116→AGENT_PLIST=\"$CHILD_HOME/Library/LaunchAgents/com.kidsafe.kiosk.plist\"\n   117→mkdir -p \"$(dirname $AGENT_PLIST)\"\n   118→\n   119→cat > \"$AGENT_PLIST\" << PLISTEOF\n   120→<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n   121→<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n   122→<plist version=\"1.0\">\n   123→<dict>\n   124→    <key>Label</key>\n   125→    <string>com.kidsafe.kiosk</string>\n   126→    <key>ProgramArguments</key>\n   127→    <array>\n   128→        <string>/usr/bin/python3</string>\n   129→        <string>${KIDSAFE_DIR}/kidsafe.py</string>\n   130→        <string>start</string>\n   131→    </array>\n   132→    <key>RunAtLoad</key>\n   133→    <true/>\n   134→    <key>KeepAlive</key>\n   135→    <true/>\n   136→    <key>StandardOutPath</key>\n   137→    <string>${CHILD_HOME}/.kidsafe/stdout.log</string>\n   138→    <key>StandardErrorPath</key>\n   139→    <string>${CHILD_HOME}/.kidsafe/stderr.log</string>\n   140→</dict>\n   141→</plist>\n   142→PLISTEOF\n   143→\n   144→chown $CHILD_USER:staff \"$AGENT_PLIST\"\n   145→chmod 644 \"$AGENT_PLIST\"\n   146→ok \"Created LaunchAgent for $CHILD_USER (auto-start on login)\"\n   147→\n   148→# --- Create LaunchAgent for admin (dashboard) ---\n   149→\n   150→ADMIN_USER=$(stat -f '%Su' /dev/console 2>/dev/null || echo \"anthonyjames\")\n   151→if [ \"$ADMIN_USER\" != \"$CHILD_USER\" ]; then\n   152→    ADMIN_PLIST=\"/Users/$ADMIN_USER/Library/LaunchAgents/com.kidsafe.dashboard.plist\"\n   153→    mkdir -p \"$(dirname $ADMIN_PLIST)\"\n   154→\n   155→    cat > \"$ADMIN_PLIST\" << PLISTEOF\n   156→<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n   157→<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n   158→<plist version=\"1.0\">\n   159→<dict>\n   160→    <key>Label</key>\n   161→    <string>com.kidsafe.dashboard</string>\n   162→    <key>ProgramArguments</key>\n   163→    <array>\n   164→        <string>/usr/bin/python3</string>\n   165→        <string>${KIDSAFE_DIR}/kidsafe.py</string>\n   166→        <string>start</string>\n   167→    </array>\n   168→    <key>RunAtLoad</key>\n   169→    <false/>\n   170→</dict>\n   171→</plist>\n   172→PLISTEOF\n   173→\n   174→    chown $ADMIN_USER:staff \"$ADMIN_PLIST\"\n   175→    chmod 644 \"$ADMIN_PLIST\"\n   176→    ok \"Created dashboard LaunchAgent for admin ($ADMIN_USER)\"\n   177→fi\n   178→\n   179→# --- Setup (password + config) ---\n   180→\n   181→echo -e \"${BLUE}Set a parent dashboard password (min 4 characters):${NC}\"\n   182→while true; do\n   183→    printf \"  Password: \"\n   184→    read -r -s ADMIN_PASS < /dev/tty\n   185→    echo\n   186→    if [ ${#ADMIN_PASS} -ge 4 ]; then\n   187→        break\n   188→    fi\n   189→    warn \"Password must be at least 4 characters. Try again.\"\n   190→done\n   191→\n   192→info \"Running setup...\"\n   193→# Set HOME so kidsafe.py writes config to the child's home directory\n   194→# Use env to pass the password safely (avoids shell escaping issues)\n   195→HOME=\"$CHILD_HOME\" KIDSAFE_SETUP_PASS=\"$ADMIN_PASS\" python3 -c \"\n   196→import os, json, hashlib, secrets, sqlite3\n   197→from pathlib import Path\n   198→\n   199→config_dir = Path.home() / '.kidsafe'\n   200→config_dir.mkdir(parents=True, exist_ok=True)\n   201→config_file = config_dir / 'config.json'\n   202→db_file = config_dir / 'activity.db'\n   203→\n   204→# Hash password\n   205→password = os.environ['KIDSAFE_SETUP_PASS']\n   206→salt = secrets.token_hex(16)\n   207→hashed = hashlib.sha256((salt + password).encode()).hexdigest()\n   208→\n   209→# Load existing config or use defaults\n   210→if config_file.exists():\n   211→    config = json.loads(config_file.read_text())\n   212→else:\n   213→    config = {}\n   214→\n   215→config['child_user'] = '$CHILD_USER'\n   216→config['admin_password_hash'] = f'{salt}:{hashed}'\n   217→config['daily_limit_minutes'] = 120\n   218→config['homepage'] = 'https://www.youtube.com/kids'\n   219→\n   220→# Ensure all default keys exist\n   221→defaults = {\n   222→    'admin_port': 8484, 'warning_minutes': 10,\n   223→    'schedule': {'enabled': True, 'allowed_start': '07:00', 'allowed_end': '20:00'},\n   224→    'firefox_kiosk': True,\n   225→    'allowed_sites': ['youtube.com','youtu.be','pbskids.org','nickjr.com','disney.com',\n   226→        'disneyplus.com','netflix.com','khanacademy.org','abcya.com','coolmathgames.com',\n   227→        'starfall.com','typingclub.com','scratch.mit.edu','code.org'],\n   228→    'blocked_sites': [], 'dns_provider': 'cleanbrowsing',\n   229→    'dns_providers': {\n   230→        'cleanbrowsing': 'https://doh.cleanbrowsing.org/doh/family-filter/',\n   231→        'cloudflare_family': 'https://family.cloudflare-dns.com/dns-query',\n   232→        'opendns': 'https://doh.familyshield.opendns.com/dns-query'\n   233→    }\n   234→}\n   235→for k, v in defaults.items():\n   236→    config.setdefault(k, v)\n   237→\n   238→config_file.write_text(json.dumps(config, indent=2))\n   239→\n   240→# Init database\n   241→conn = sqlite3.connect(str(db_file))\n   242→conn.execute('CREATE TABLE IF NOT EXISTS sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, start_time TEXT NOT NULL, end_time TEXT, duration_seconds INTEGER DEFAULT 0)')\n   243→conn.execute('CREATE TABLE IF NOT EXISTS daily_usage (date TEXT PRIMARY KEY, total_seconds INTEGER DEFAULT 0)')\n   244→conn.execute('CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT NOT NULL, event_type TEXT NOT NULL, detail TEXT)')\n   245→conn.commit()\n   246→conn.close()\n   247→\n   248→print('Config saved to ' + str(config_file))\n   249→\"\n   250→\n   251→# Fix ownership — installer runs as root but config belongs to child\n   252→chown -R $CHILD_USER:staff \"$CHILD_HOME/.kidsafe\"\n   253→\n   254→# Apply Firefox policies (needs root for /Applications/Firefox.app)\n   255→python3 \"$KIDSAFE_DIR/kidsafe.py\" policies\n   256→ok \"Setup complete\"\n   257→\n   258→# --- Start kidsafe ---\n   259→\n   260→info \"Starting KidSafe...\"\n   261→sudo -u $CHILD_USER nohup python3 \"$KIDSAFE_DIR/kidsafe.py\" start \\\n   262→    >> \"$CHILD_HOME/.kidsafe/stdout.log\" \\\n   263→    2>> \"$CHILD_HOME/.kidsafe/stderr.log\" &\n   264→sleep 2\n   265→if pgrep -f \"kidsafe.py start\" >/dev/null 2>&1; then\n   266→    ok \"KidSafe is running\"\n   267→else\n   268→    warn \"KidSafe did not start — check logs at $CHILD_HOME/.kidsafe/stderr.log\"\n   269→fi\n   270→\n   271→# --- Done ---\n   272→\n   273→echo\n   274→echo -e \"${GREEN}╔══════════════════════════════════════╗${NC}\"\n   275→echo -e \"${GREEN}║     Installation Complete!            ║${NC}\"\n   276→echo -e \"${GREEN}╚══════════════════════════════════════╝${NC}\"\n   277→echo\n   278→echo -e \"  KidSafe is installed and configured for ${YELLOW}$CHILD_USER${NC}.\"\n   279→echo\n   280→echo -e \"  ${BLUE}What happens now:${NC}\"\n   281→echo -e \"  - Kiosk auto-starts when $CHILD_USER logs in\"\n   282→echo -e \"  - Firefox opens in fullscreen with content filtering\"\n   283→echo -e \"  - Daily limit: ${YELLOW}120 minutes${NC} (change in dashboard)\"\n   284→echo -e \"  - Schedule: ${YELLOW}7:00 AM – 8:00 PM${NC} (change in dashboard)\"\n   285→echo\n   286→echo -e \"  ${BLUE}Parent dashboard:${NC}\"\n   287→echo -e \"     ${YELLOW}http://127.0.0.1:8484${NC}\"\n   288→echo\n   289→echo -e \"  ${BLUE}Manual commands:${NC}\"\n   290→echo -e \"     ${YELLOW}kidsafe start${NC}    — start kiosk\"\n   291→echo -e \"     ${YELLOW}kidsafe stop${NC}     — stop kiosk\"\n   292→echo -e \"     ${YELLOW}kidsafe status${NC}   — check status\"\n   293→echo -e \"     ${YELLOW}kidsafe setup${NC}    — change settings\"\n   294→echo\n   295→echo -e \"  ${BLUE}To uninstall:${NC}\"\n   296→echo -e \"     ${YELLOW}sudo bash $KIDSAFE_DIR/uninstall.sh${NC}\"\n   297→echo -e \"     or: ${YELLOW}curl -fsSL ${REPO_URL}/uninstall.sh | sudo bash${NC}\"\n   298→echo\n   299→"}]},"parent_tool_use_id":"toolu_01LS7mLKx1WRxatd7m3Xq9rh","session_id":"5f02eaca-ad87-4794-81b5-499b307ad8d6","uuid":"9fa27aba-cbe0-4f3d-83a0-b28769f80516"}
